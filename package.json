{
  "name": "@epubjs-react-native/core",
  "version": "1.4.7-mason.3",
  "description": "A digital book reader in .opf .epub format for react native using epub.js library inside a webview.",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "react-native": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "epubjs-react-native.podspec",
    "docs/PARITY_PROVENANCE.md",
    "generated-artifacts.json",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    ".nvmrc",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "prettier:format": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc -p tsconfig.build.json --noEmit --pretty",
    "test": "jest --runInBand --passWithNoTests",
    "test:coverage": "jest --coverage --no-cache --runInBand --passWithNoTests --forceExit",
    "engine:install": "npm --prefix vendor/epub.js ci --ignore-scripts",
    "build:epubjs-source": "node scripts/build-epubjs.mjs",
    "generate:epubjs": "npm run build:epubjs-source && node scripts/generated-artifacts.mjs generate epubjs",
    "check:epubjs": "node scripts/generated-artifacts.mjs check epubjs",
    "generate:jszip": "node scripts/generated-artifacts.mjs generate jszip",
    "check:jszip": "node scripts/generated-artifacts.mjs check jszip",
    "generate:generated": "npm run generate:epubjs && npm run generate:jszip",
    "check:generated": "npm run check:epubjs && npm run check:jszip",
    "build": "bob build",
    "release": "npm run build && npm publish",
    "release:beta": "npm run build && npm publish --tag beta",
    "release:alpha": "npm run build && npm publish --tag alpha",
    "release-local": "npm run build && npm link && echo [FINISH]: Run \"npm link @epubjs-react-native/core\" to link the package to your project",
    "release-to-examples": "npm run build && node ./scripts/release-to-examples.js",
    "example-bare": "npm --prefix example-bare install",
    "example-expo": "npm --prefix example-expo install",
    "bootstrap": "npm run example-bare && npm run example-expo && npm install"
  },
  "keywords": [
    "react",
    "ios",
    "android",
    "react-native",
    "epub",
    "epub-reader",
    "epubjs"
  ],
  "repository": "https://github.com/masonbrothers/epubjs-react-native",
  "author": "Victor Soares <vitorsoares96@hotmail.com> (https://github.com/victorsoares96)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/masonbrothers/epubjs-react-native/issues"
  },
  "homepage": "https://github.com/masonbrothers/epubjs-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@react-native/babel-preset": "0.79.5",
    "@testing-library/react-native": "12.6.0",
    "@types/jest": "29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "19.0.0",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "14.0.0",
    "jest": "29.7.0",
    "jszip": "3.10.1",
    "pod-install": "0.2.2",
    "prettier": "3.2.5",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-builder-bob": "0.23.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-webview": "13.13.5",
    "react-test-renderer": "19.0.0",
    "ts-jest": "29.1.4",
    "ts-node": "10.9.2",
    "typescript": "~5.8.3"
  },
  "resolutions": {
    "@types/react": "~19.0.10"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-webview": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "sourceMaps": false
        }
      ],
      [
        "module",
        {
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
